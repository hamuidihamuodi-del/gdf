<html lang="ar" dir="rtl"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ليون العراقي - رفع الصور</title>
<style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:18px;background:radial-gradient(circle at top,#34205b,#100c20 60%,#07070d);font-family:Tahoma,Arial;color:#fff}
.card{width:min(560px,100%);padding:25px;border:1px solid #d9bd7a;border-radius:22px;background:linear-gradient(145deg,#21172e,#100d19);box-shadow:0 0 30px #c9a65a44;text-align:center}
.logo{font-size:45px}.title{font-size:27px;color:#f2d99c;margin:5px}.sub{color:#c8bdd7;font-size:14px;margin:0 0 22px}
.drop{display:block;border:2px dashed #b89a5e;border-radius:16px;padding:28px 15px;background:#ffffff08;cursor:pointer}.drop:hover{background:#b89a5e18}
.drop strong{display:block;font-size:18px;margin:8px}.drop small{color:#c9bdd7}input[type=file]{display:none}
button{border:0;border-radius:10px;padding:12px 18px;background:linear-gradient(120deg,#7540a6,#3a1a60);color:white;font-size:15px;font-weight:bold;cursor:pointer;margin:9px 4px}button:disabled{opacity:.5;cursor:wait}
#status{min-height:35px;margin:13px 0;color:#f0dba8;font-size:14px;line-height:1.7}
#result{display:none;text-align:right;margin-top:16px;padding:14px;background:#ffffff0c;border:1px solid #ffffff24;border-radius:14px}
#preview{display:block;max-width:100%;max-height:300px;margin:0 auto 12px;border-radius:10px}
.linkrow{display:flex;gap:7px;direction:ltr}.linkrow input{min-width:0;flex:1;background:#090711;color:#bdf4c8;border:1px solid #5b4b70;border-radius:8px;padding:10px;font-size:12px}
.note{font-size:12px;color:#a99bbd;line-height:1.9;margin-top:18px}.progress{height:7px;background:#ffffff20;border-radius:10px;overflow:hidden;display:none}.bar{height:100%;width:0;background:#d9bd7a;transition:width .2s}
</style></head>
<body><main class="card">
<div class="logo">🦁</div><h1 class="title">ليون العراقي</h1><p class="sub">رفع الصور واستخراج رابط مباشر</p>
<label class="drop" id="drop"><div style="font-size:38px">📷</div><strong>اضغط لاختيار صورة أو اسحبها هنا</strong><small>JPG · PNG · GIF · WEBP · BMP · AVIF — حتى 16 MB</small><input id="file" type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/bmp,image/avif"></label>
<button id="upload" disabled="">رفع الصورة الآن</button><div class="progress" id="progress"><div class="bar" id="bar"></div></div><div id="status">اختر صورة للبدء</div>
<section id="result"><img id="preview" alt="معاينة الصورة"><label>الرابط المباشر:</label><div class="linkrow"><input id="url" readonly=""><button id="copy">نسخ الرابط</button></div></section>
<p class="note">الخدمة المستخدمة: ImgDB. لا تحتاج مفتاح API أو تسجيل حساب. الصور عامة لمن يملك الرابط، والروابط الافتراضية تنتهي بعد 72 ساعة. الحد الأقصى 16 MB للصورة و50 عملية رفع في الدقيقة لكل IP.</p>
</main>
<script>
const $=id=>document.getElementById(id);
let chosen=null;
function selectFile(f){
 if(!f)return;
 if(!/^image\/(jpeg|png|gif|webp|bmp|avif)$/.test(f.type)){ $('status').textContent='نوع الصورة غير مدعوم. اختر JPG أو PNG أو GIF أو WEBP أو BMP أو AVIF.';return}
 if(f.size>16*1024*1024){$('status').textContent='حجم الصورة أكبر من 16 ميغابايت.';return}
 chosen=f;$('upload').disabled=false;$('status').textContent='تم اختيار: '+f.name+' ('+(f.size/1024/1024).toFixed(2)+' MB)';$('result').style.display='none';
}
$('file').addEventListener('change',e=>selectFile(e.target.files[0]));
$('drop').addEventListener('dragover',e=>{e.preventDefault();$('drop').style.background='#b89a5e22'});
$('drop').addEventListener('dragleave',()=>$('drop').style.background='');
$('drop').addEventListener('drop',e=>{e.preventDefault();$('drop').style.background='';selectFile(e.dataTransfer.files[0])});
$('upload').addEventListener('click',async()=>{
 if(!chosen)return;
 $('upload').disabled=true;$('progress').style.display='block';$('bar').style.width='25%';$('status').textContent='جارٍ رفع الصورة...';
 try{
   const form=new FormData();form.append('file',chosen,chosen.name);
   // ImgDB official endpoint. ttl=0 requests a non-expiring link.
   const response=await fetch('https://imgdb.io/api/v1/upload?ttl=0',{method:'POST',body:form});
   $('bar').style.width='80%';
   const raw=await response.text();let data;
   try{data=JSON.parse(raw)}catch{throw new Error('رد الخادم ليس JSON. HTTP '+response.status+' — '+raw.slice(0,180))}
   if(!response.ok)throw new Error((data.error||'فشل الرفع')+' (HTTP '+response.status+')');
   if(!data.url)throw new Error('لم يصل رابط الصورة من الخادم.');
   $('url').value=data.url;$('preview').src=data.url;$('result').style.display='block';
   $('status').textContent='تم رفع الصورة بنجاح ✓';$('bar').style.width='100%';
 }catch(err){
   let msg=err.message||String(err);
   if(err instanceof TypeError || /Failed to fetch|NetworkError/i.test(msg)){
    msg='تعذر الاتصال بالخدمة (غالباً CORS أو حجب من الشبكة). لا تفتح الملف بالنقر المزدوج فقط؛ ارفعه إلى استضافة HTTPS مثل GitHub Pages وجرب الرابط المنشور، أو جرّب شبكة أخرى.';
   }
   $('status').textContent='خطأ: '+msg;$('bar').style.width='0%';
 }finally{$('upload').disabled=false}
});
$('copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText($('url').value);$('copy').textContent='تم النسخ ✓'}catch{$('url').select();document.execCommand('copy');$('copy').textContent='تم النسخ ✓'}});
</script></body></html>
